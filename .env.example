# Google Gemini API Key (Get free key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional frontend configuration (default is local backend http://localhost:8000)
# VITE_API_URL=http://localhost:8000

# Optional Google Identity Services Client ID (for official Google Sign-In)
# VITE_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# Optional Real Email SMTP Configuration (for sending OTPs directly to inbox)
# For Gmail: Use smtp.gmail.com with port 587 and an App Password (https://myaccount.google.com/apppasswords)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_gmail_app_password
# SMTP_FROM=AI Humanizer <your_email@gmail.com>

